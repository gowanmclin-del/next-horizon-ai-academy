# ---------------------------------------------------------------------------
# Next Horizon AI Academy — environment variables (Phase 16)
# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values. Never commit
# .env.local or real secrets — .gitignore already excludes it.

# --- Supabase (auth + Postgres database) -----------------------------------
# From your Supabase project's Settings → API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only — NEVER exposed to the browser, NEVER imported by client
# components. As of Phase 6 this key IS used, but only inside
# app/api/webhooks/stripe/route.ts (via lib/supabase/admin.ts) — see that
# file's comment for why a Stripe webhook specifically needs it (there is
# no Supabase session on a webhook request, so RLS has nothing to scope
# against). Every write that key enables is still restricted a second time
# at the database layer: process_stripe_payment_event() and the
# *_email_*_for_user() functions in supabase/phase6.sql are themselves
# granted to `service_role` only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Transactional email (Resend) -------------------------------------------
# Optional — every email send gracefully no-ops if these are unset (see
# lib/email/resend.ts). No student workflow depends on email sending.
RESEND_API_KEY=
EMAIL_FROM=

# --- Site URL (used for links inside emails, and Stripe redirect URLs) -----
# Used by lib/email/site-url.ts to build CTA links inside emails, and — via
# the stricter getValidatedSiteUrlForCheckout() in that same file — to
# build Stripe's success_url/cancel_url for lib/actions/payments.ts.
#
# REQUIRED for checkout to work at all. As of Phase 16, this is validated
# BEFORE a Stripe Checkout Session is ever created: it must be a valid
# absolute http:// or https:// URL, and in production it must be https://
# and not localhost. If it's missing or invalid, checkout fails immediately
# with a clear configuration error — it no longer falls back to a relative
# URL (a relative URL is not valid for Stripe's success_url/cancel_url and
# would have produced a broken checkout).
#
# Email links degrade more gently: if this is unset, transactional emails
# still send, just without their call-to-action button/link.
#
# Local development: http://localhost:3000 is fine here (this is the
# normal way to test Stripe checkout locally with `stripe listen`).
# Production: must be your real https:// domain — not localhost, and not
# a placeholder like example.com or nexthorizonaiacademy.com.
# Example: NEXT_PUBLIC_SITE_URL=https://www.nexthorizonaiacademy.com
NEXT_PUBLIC_SITE_URL=

# --- Contact email (optional but recommended before launch) ----------------
# Shown as a working mailto: link on the /contact page. This is meant to be
# public information, hence the NEXT_PUBLIC_ prefix — it is not a secret.
# If unset, the Contact page shows a professional "check back soon" message
# instead of inventing an address.
# Example: NEXT_PUBLIC_CONTACT_EMAIL=hello@nexthorizonaiacademy.com
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Stripe (payments) -------------------------------------------------------
# Server only — NEVER exposed to the browser. Used in lib/stripe/server.ts,
# only ever imported from Server Actions (lib/actions/payments.ts) and the
# webhook route (app/api/webhooks/stripe/route.ts).
# Use sk_test_... for the full acceptance test. Switch to sk_live_... only
# after the complete payment-to-certificate journey passes.
STRIPE_SECRET_KEY=

# Server only. Used to verify that incoming webhook requests genuinely came
# from Stripe (HMAC signature check) — see app/api/webhooks/stripe/route.ts.
# Get this from the Stripe Dashboard when you create the webhook endpoint,
# or from `stripe listen` when testing locally with the Stripe CLI.
STRIPE_WEBHOOK_SECRET=

# This app's current Checkout implementation does not need a publishable
# key (STRIPE_PUBLISHABLE_KEY / NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY) — the
# student is redirected to a Stripe-hosted Checkout page via a URL returned
# from the server, rather than using Stripe.js in the browser. If a future
# phase adds an embedded/Elements-based checkout instead of hosted
# Checkout, a publishable key would be needed then, and — being
# publishable, not secret — it would correctly use the NEXT_PUBLIC_ prefix
# at that point.

# --- Error monitoring (Phase 14, optional) ----------------------------------
# No monitoring SDK is installed in this codebase yet (see lib/monitoring.ts)
# — server-side errors are always logged to the console, which most hosting
# platforms capture on their own. Setting either of these does NOT connect a
# real provider by itself; it only flips isErrorMonitoringConfigured() to
# true, which is a no-op until lib/monitoring.ts is filled in with a real
# SDK call. Rename to match whichever provider is actually adopted.
ERROR_MONITORING_DSN=
# Only needed if the chosen provider requires client-side (browser) reporting.
NEXT_PUBLIC_ERROR_MONITORING_DSN=

# --- Analytics (Phase 14, optional) -----------------------------------------
# No analytics provider is installed. lib/analytics.ts's track() calls are
# complete no-ops — nothing loads, nothing fires, no cookie is set — unless
# this is set. Consider cookie-consent requirements in your jurisdiction
# before enabling a real provider.
NEXT_PUBLIC_ANALYTICS_ID=
